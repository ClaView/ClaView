{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "claview-mappings/2"
    },
    "source_version": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "string",
          "minLength": 1
        },
        "legacy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "catalog",
        "metadata",
        "legacy"
      ],
      "additionalProperties": false
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1
          },
          "search_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "doc_id",
                "field",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "concept_id",
          "canonical_name",
          "search_terms",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mapping_id": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "alternative_concept_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "relation": {
            "enum": [
              "alias",
              "abbreviation",
              "spelling_variant",
              "definition",
              "related_concept",
              "ambiguous"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "org_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "table_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "org_ids",
              "table_ids"
            ],
            "additionalProperties": false
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "any_positive": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "any_positive"
              ],
              "additionalProperties": false
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "any_positive": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "required": [
                "any_positive"
              ],
              "additionalProperties": false
            }
          },
          "condition_status": {
            "enum": [
              "structured",
              "unresolved"
            ]
          },
          "legacy_condition": {
            "type": "string"
          },
          "source_version": {
            "type": "object",
            "properties": {
              "catalog": {
                "type": "string",
                "minLength": 1
              },
              "metadata": {
                "type": "string",
                "minLength": 1
              },
              "legacy": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "catalog",
              "metadata",
              "legacy"
            ],
            "additionalProperties": false
          },
          "review_status": {
            "enum": [
              "draft",
              "approved",
              "rejected"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "source_mapping_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "source_mapping_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mapping_id",
          "expression",
          "concept_id",
          "alternative_concept_ids",
          "relation",
          "scope",
          "conditions",
          "exclusions",
          "condition_status",
          "legacy_condition",
          "source_version",
          "review_status",
          "reviewer",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_version",
    "concepts",
    "mappings"
  ],
  "additionalProperties": false
}
