{
  "_about": [
    "Word lists and patterns of table selection (plan 04, 4-1: 3.1-3.5). Ported from the old A pipeline (commit 55fd41b):",
    "src/claview/aflow/rules.py (TITLE_ONLY_AXES :638, HANDOFF_ONLY_AXES :681, CURRENCY_ITEM/_CUR_TAIL/FOREIGN_ITEM :715-721,",
    "DEFAULT_CURRENCY/_MONEY_UNIT/UNIT_CURRENCY :728-730, _UNIT_SCALE/_UNIT_PARTS :758-759, FREQ_MONTHS/LAG_PERIODS :560-561),",
    "src/claview/aflow/j_nodes.py (_STOP_TERMS/_TAIL :42-43, _BYEOL_MARK/_BYEOL_JOIN :250-251, _COMBINED_VALUE :338),",
    "src/claview/aflow/measure.py (_FUNCTION/_TAIL :18-20), src/claview/aflow/catalog.py (_PUNCT/_ABBR :19-20).",
    "Order and contents unchanged; the basis axes themselves are the find_conditions list (condition_words.json basis_axes)."
  ],
  "title_only_axes": ["survey_view", "valuation"],
  "handoff_only_axes": ["comparison", "calc"],
  "currency_tail": "(?=$|[^가-힣]|기준|표시|화|결제|예금|예수금|예치금|대출금|대출|채권|자금)",
  "currency_item": {
    "원화": "원화{tail}",
    "달러": "(?:(?<![가-힣])달러|미달러){tail}",
    "계약통화": "계약통화{tail}"
  },
  "foreign_item": "외화{tail}",
  "default_currency": "원화",
  "money_unit": "(?:십억|백만|십만|천만|천|만|억|조)?(원|달러)",
  "unit_currency": {"원": "원화", "달러": "달러"},
  "unit_scale": {"": 1, "천": 1000, "백만": 1000000, "천만": 10000000, "억": 100000000, "십억": 1000000000,
                 "조": 1000000000000},
  "unit_parts": "(십억|백만|천만|천|억|조)?(원|달러|%)",
  "percent_words": ["퍼센트"],
  "freq_months": {"Y": 12, "H": 6, "Q": 3, "M": 1},
  "lag_periods": 2,
  "stop_terms": ["그래프", "추이", "비교", "흐름", "자료", "표", "기준", "규모", "지표", "전체", "각각"],
  "token_tail": "(?:으로|에서|의|을|를|이|가|은|는|로|에|와|과|도|만)$",
  "token_trim": "[()\\[\\],.?!]+$",
  "token_marks": "[()\\[\\],.?!]",
  "basis_suffix": "기준",
  "byeol_mark": "(?:등|같은|처럼)\\s*$",
  "byeol_join": "(?:와|과|및|이나|또는)$",
  "byeol_join_inner": "(?:와|과|및|이나|또는)(?=\\s)",
  "byeol_byname": "[가-힣]{2,}별",
  "list_separators": ",·/",
  "combined_value": "\\S\\s*[-×_/]\\s*\\S",
  "search_punct": "[\\s·ㆍ,()\\[\\]{}<>/\\-_.:;'\"]+",
  "abbreviation": "([가-힣][가-힣\\s·]{1,30}?)\\s*\\(([A-Za-z][A-Za-z0-9]{1,9})\\)"
}
