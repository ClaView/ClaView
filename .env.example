# Copy to .env (Git-ignored). docker-compose.yaml reads it with env_file; never write keys in compose files.
# synthetic: no external call, synthetic B model and KOSIS values (wiring check, not accuracy)
# live:      OpenAI (B's model, fixed to gpt-6.1-terra in claview_common.settings.B_MODEL_ID) and
#            KOSIS are called. Approve call count and cost first (AGENTS.md).
CLAVIEW_MODE=synthetic

# One OpenAI key for the whole app: A and B read OPENAI_API_KEY from this file / the environment.
OPENAI_API_KEY=
KOSIS_API_KEY=

# Host ports (container port is 8888 for every backend, 80 for the frontend)
FRONTEND_PORT=10300
PIPELINE_PORT=10301
A_PORT=10311
B_PORT=10312
C_PORT=10313
