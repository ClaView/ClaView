# Copy to .env (Git-ignored). docker-compose.yaml reads it with env_file; never write keys in compose files.
# synthetic: no external call, synthetic B model and KOSIS values (wiring check, not accuracy)
# live:      HCX/OpenAI and KOSIS are called. Approve call count and cost first (AGENTS.md).
CLAVIEW_MODE=synthetic

CLOVASTUDIO_API_KEY=
KOSIS_API_KEY=
# Optional: B uses OpenAI only when this is set and CLOVASTUDIO_API_KEY is empty.
OPENAI_API_KEY=
HCX_MIN_INTERVAL_SEC=35

# Host ports (container port is 8888 for every backend, 80 for the frontend)
FRONTEND_PORT=10300
PIPELINE_PORT=10301
A_PORT=10311
B_PORT=10312
C_PORT=10313
