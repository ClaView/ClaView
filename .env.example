# Copy to .env (Git-ignored). docker-compose.yaml reads it with env_file; never write keys in compose files.
# live (default): the normal screen calls A -> B -> KOSIS -> C. A and B use OpenAI.
#            Set both keys below and recreate the containers. See docs/guides/Docker_실호출_실행.md.
#            Approve the scope and cost of agent-operated checks first (AGENTS.md).
# Missing keys leave the service unready; it never falls back to synthetic output.
# synthetic: explicitly opt in only for dev/test, no external calls, synthetic judgments and values.
CLAVIEW_MODE=live

# One OpenAI key for the whole app: A and B read OPENAI_API_KEY from this file / the environment.
OPENAI_API_KEY=
KOSIS_API_KEY=

# Normal live use does not require an evaluation approval JSON.
# Only for an explicitly approved evaluation: set a container-visible approval path.
# An invalid/expired approval remains a refusal; it does not fall back to normal live use.
# CLAVIEW_A_LIVE_APPROVAL=/claview/runs/approvals/approval.json
# docker-compose.yaml fixes the shared A record base to /claview/runs/a_service.
# Normal records use separate live/ and synthetic/ subdirectories in a persistent volume.
# Loading a saved real result is not synthetic mode and does not make new external calls.

# Host ports (container port is 8888 for every backend, 80 for the frontend)
FRONTEND_PORT=10300
PIPELINE_PORT=10301
A_PORT=10311
B_PORT=10312
C_PORT=10313
