      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "claview-a-eval/1"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "regression",
            "dev",
            "test_expression",
            "test_family"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "query_revision": {
                "type": "integer",
                "minimum": 1
              },
              "prior_turns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "role": {
                      "enum": [
                        "user",
                        "assistant"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "role",
                    "text"
                  ]
                },
                "minItems": 0,
                "uniqueItems": false
              }
            },
            "required": [
              "case_id",
              "query",
              "query_revision",
              "prior_turns"
            ]
          },
          "minItems": 1,
          "uniqueItems": false
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "split",
        "cases"
      ]
    },
