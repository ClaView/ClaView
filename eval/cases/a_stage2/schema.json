          "minItems": 0,
          "uniqueItems": false
        },
        "decision": {
          "enum": [
            "display_candidates",
            "ask_clarification",
            "out_of_scope",
            "insufficient_evidence",
            "technical_failure"
          ]
        },
        "clarification_axes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "before_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+:[A-Za-z0-9_]+$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "after_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+:[A-Za-z0-9_]+$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "display_order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]+:[A-Za-z0-9_]+$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "external_api_calls": {
              "type": "integer",
              "minimum": 0
            },
            "blocked_network_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "b_calls": {
              "type": "integer",
              "minimum": 0
            },
            "billed_cost_usd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model_calls",
            "external_api_calls",
            "blocked_network_attempts",
            "b_calls",
            "billed_cost_usd"
          ]
        },
        "trace": {
          "type": "object"
        }
      },
      "required": [
        "case_id",
        "query",
        "query_revision",
        "prior_turns",
        "decision",
        "clarification_axes",
        "before_ids",
        "after_ids",
        "display_order",
        "error_code",
        "elapsed_ms",
        "usage",
        "trace"
      ]
