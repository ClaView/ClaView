  "uncertainty": {
    "_note": "Plan 11 G and 7-12 (first values, read by the gate in R2): an interpretation uncertainty with its target requirement maps to one way. Not classifiable, no target requirement, or several kinds at once: ask.",
    "no_block": ["leftover_in_dictionary", "derived_name", "model_choice_rechecked", "user_answered"],
    "confirm_if_readings_same": ["scope_ambiguous", "ambiguous_attribution", "unused_name", "appositive", "mixed_reading"],
    "confirm_drop_or_rephrase": ["ungrounded"],
    "default": "ask"
  },
  "confirm_allowed": [],
  "no_ask": {
    "_note": "Plan 11 8-3-3 and F11: the only reasons not to ask; 'written' is limited to own and common conditions the interpretation settled (no negated or ambiguous condition, no raw substring).",
    "rules": ["question_wrote_single_value", "question_wrote_whole_table_name"],
    "option_form": "choices only with two or more options that yield a table when selected again; otherwise an open question"
  },
  "effect_rules": {
    "_note": "Plan 11 R1b (C15): the execution rules of select/needs.py, apart from field_effects (one row per field, the coverage test). One fact may give several uses at once: 3_question_set includes 2_evidence, 2_evidence includes 1_filter (a refutation). Only settled values are used: a value is settled per (requirement identity key, condition or fragment ID) by judgement.failed_sources; interp.status and judgement.certain are not read.",
    "filter": ["negated_fragment", "basis_polarity_minus", "exclude"],
    "evidence": ["indicator_name", "target_name", "lower_item_name", "period", "unit", "breakdown", "exclude", "basis", "frequency"],
    "question_set": ["frequency", "basis_polarity_plus"]
  },
  "refutations": {
    "_note": "Plan 11 4-1 as changed by 13 and 14: the refutation codes select/refute.py may apply, true = on. R1b: observation path only (signals.decision_preview); latest_stale is dropped (C11); answer_excluded, answer_conflict and option_no_table come in R2, period_outside_anchor in R4a, indicator_mention_only in R4b, relation_conflict in R4c.",
    "indicator_absent": true,
    "target_absent": true,
    "lower_item_absent": true,
    "condition_conflict": true,
    "forbidden_only": true,
    "negated_name_only": true,
    "cells_impossible": true,
    "period_outside_anchor": false,
    "answer_conflict": false,
    "answer_excluded": false,
    "indicator_mention_only": false,
    "relation_conflict": false,
    "option_no_table": false,
    "_r1c_note": "R1c (observation only): condition_conflict from a title or bracket basis value needs the requested value nowhere on the table (title, path, values, axis names). indicator_mention_only (the indicator name only inside longer names, complete surface, settled and mapped name) is implemented but stays off: turning it on breaks the existing expectation tests_v3/test_select_refute.py::test_negated_name_only_both_ways (a table holding the name only inside a longer value is kept), so it needs a decision first. relation_conflict stays off (relations are a decision dimension; no settled scope phrase in the interpretation)."
  },
  "certainty": {
    "_note": "Plan 11 R1c (select/needs.py): failed sources about a name mapping only. A source with this condition whose detail ends in ':<part>' with a listed part unsettles that fragment's names (indicator, target, lower item) but not the conditions read inside the fragment; those keep their own sources. Remove an entry to go back to the R1b rule (every condition inside an unsettled fragment is unsettled).",
    "name_only_sources": {"inexact_term": ["indicator", "context", "target", "lower"]}
  }
